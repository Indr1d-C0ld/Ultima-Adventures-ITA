<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Linux/Mono: la compressione dei pacchetti usa zlib di sistema.
       Debian fornisce solo libz.so.1 (libz.so esiste solo con il pacchetto -dev). -->
  <dllmap dll="libz" target="libz.so.1" os="linux" />
  <dllmap dll="zlib64" target="libz.so.1" os="linux" />
  <dllmap dll="zlib32" target="libz.so.1" os="linux" />
</configuration>
